{
  "name": "weather-spa",
  "version": "1.0.0",
  "description": "NextGen Europa — Weather SPA (PWA) para viajeros europeos",
  "private": true,
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "tailwind:watch": "npx tailwindcss -i ./input.css -o ./tailwind-dist.css --watch",
    "build:css": "npx tailwindcss -i ./input.css -o ./tailwind-dist.css --minify",
    "build:minify": "node build.js",
    "build": "npm run build:css && npm run build:minify"
  },
